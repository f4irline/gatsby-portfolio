---
import { site } from '../data/site';
---

<main class="hero-container">
    <div class="profile">
        <header class="identity">
            <p class="eyebrow"><span aria-hidden="true"></span>{site.name}</p>
            <p class="role">{site.role}</p>
            <p class="context">{site.location} <span aria-hidden="true">·</span> {site.currentCompany}</p>
        </header>

        <section class="introduction" aria-labelledby="profile-heading">
            <h1 id="profile-heading">{site.headline}</h1>
            <div class="copy">
                {site.introduction.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <nav class="social-links" aria-label="Tommi Lepola's links">
                {
                    site.socialLinks.map((link) => (
                        <a href={link.url}>
                            <img src={link.icon} alt="" width="22" height="22" />
                            <span>{link.label}</span>
                            <span class="link-arrow" aria-hidden="true">↗</span>
                        </a>
                    ))
                }
            </nav>
        </section>
    </div>
</main>

<style>
    .hero-container {
        width: 100%;
        min-height: 100svh;
        padding: clamp(3rem, 9vh, 8rem) clamp(1.25rem, 5vw, 5rem);
    }

    .profile {
        display: grid;
        width: min(100%, var(--content-width));
        margin: 0 auto;
        gap: 2.75rem;
    }

    .identity {
        align-self: start;
    }

    .eyebrow,
    .role,
    .context {
        margin: 0;
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: var(--color-text);
        font-size: clamp(0.875rem, 1.2vw, 1rem);
        font-weight: 700;
    }

    .eyebrow span {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: var(--color-primary);
    }

    .role {
        margin-top: 0.75rem;
        color: var(--color-muted);
        font-size: clamp(0.875rem, 1.2vw, 1rem);
    }

    .context {
        margin-top: 1.5rem;
        color: var(--color-muted);
        font-size: clamp(0.875rem, 1.2vw, 1rem);
        line-height: 1.5;
    }

    h1 {
        max-width: 12ch;
        margin: 0;
        color: var(--color-text);
        font-family: 'Rubik', sans-serif;
        font-size: clamp(3rem, 7vw, 6.25rem);
        font-weight: 700;
        letter-spacing: -0.045em;
        line-height: 0.98;
    }

    .copy {
        max-width: 60ch;
        margin-top: clamp(1.75rem, 4vw, 2.75rem);
    }

    .copy p {
        margin: 0;
        color: var(--color-text);
        font-size: clamp(1.125rem, 1.5vw, 1.375rem);
        line-height: 1.5;
    }

    .copy p + p {
        margin-top: 1rem;
    }

    .social-links {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        margin-top: clamp(2rem, 5vw, 3.5rem);
        overflow: hidden;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-small);
    }

    .social-links a {
        display: grid;
        grid-template-columns: 1.25rem minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.6rem;
        min-height: 3.5rem;
        padding: 0.75rem;
        color: var(--color-text);
        font-size: clamp(0.875rem, 1.2vw, 1rem);
        font-weight: 700;
        text-decoration: none;
        transition: background-color 180ms ease, color 180ms ease;
    }

    .social-links a + a {
        border-left: 1px solid var(--color-border);
    }

    .social-links img {
        width: 1.25rem;
        height: 1.25rem;
        filter: invert(97%) sepia(8%) saturate(415%) hue-rotate(332deg)
            brightness(104%) contrast(90%);
    }

    .link-arrow {
        color: var(--color-muted);
        transition: transform 180ms ease, color 180ms ease;
    }

    .social-links a:hover {
        background: var(--color-primary-soft);
        color: var(--color-primary);
    }

    .social-links a:hover img {
        filter: invert(52%) sepia(49%) saturate(4975%) hue-rotate(330deg)
            brightness(104%) contrast(101%);
    }

    .social-links a:hover .link-arrow {
        color: var(--color-primary);
        transform: translate(2px, -2px);
    }

    .social-links a:focus-visible {
        outline: 3px solid var(--color-primary);
        outline-offset: -3px;
    }

    @media (min-width: 900px) {
        .hero-container {
            display: grid;
            align-items: center;
        }

        .profile {
            grid-template-columns: minmax(12rem, 0.7fr) minmax(0, 1.8fr);
            gap: clamp(3rem, 8vw, 8rem);
        }
    }

    @media (max-width: 560px) {
        .social-links {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .social-links a:nth-child(3) {
            border-left: 0;
            border-top: 1px solid var(--color-border);
        }

        .social-links a:nth-child(4) {
            border-top: 1px solid var(--color-border);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .profile {
            animation: reveal 450ms ease-out both;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .profile {
            animation: none;
        }

        .social-links a,
        .link-arrow {
            transition: none;
        }
    }

    @keyframes reveal {
        from {
            transform: translateY(10px);
        }

        to {
            transform: translateY(0);
        }
    }
</style>
